@page "/Mandamentos/{mandamentoId:int}/Propor"
@model Projetar.Web.Pages.PropostaItem.ProporModel
@{
    Layout = "_LayoutPj";
    ViewData["Title"] = "Propor novo item";
    ViewData["NavAtivo"] = "Propostas";
}

<div class="pj-shell pj-breadcrumb">
    <a href="/">Início</a><span class="sep">/</span>
    <a href="/#principio-@Model.MandamentoAtual.Id">Princípio @Model.MandamentoAtual.Id</a><span class="sep">/</span>
    <span class="current">Propor novo item</span>
</div>

<div class="pj-shell pj-edit" data-pp-root>

    <div class="pj-col">
        <div class="pj-card">

            @* ---------- Banner ---------- *@
            <input type="file" id="pp-banner-file" data-pp-banner-input accept="image/jpeg,image/png,image/webp" style="display:none;" />
            <input type="file" id="pp-inline-file" data-pp-inline-image accept="image/jpeg,image/png,image/webp" style="display:none;" />

            <div data-pp-banner-filled hidden>
                <div class="pj-edit-banner" style="height:240px;">
                    <img data-pp-banner-img src="@Model.Input.BannerUrl" alt="Banner do item" />
                    <span class="pj-edit-banner__status"><i style="background:var(--pj-gold);"></i>Pré-visualização</span>
                    <div class="pj-edit-banner__tools">
                        <button type="button" class="pj-icon-btn" title="Editar banner" data-pp-banner-menu-toggle>
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                        </button>
                        <div class="pj-menu" data-pp-banner-menu hidden>
                            <label for="pp-banner-file" class="pj-menu__item">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
                                Trocar imagem
                            </label>
                            <button type="button" class="pj-menu__item pj-menu__item--danger" data-pp-banner-remove>
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>
                                Remover banner
                            </button>
                            <div class="pj-menu__note">JPG, PNG ou WEBP · máx. 5 MB · 1600 × 500 px</div>
                        </div>
                    </div>
                </div>
            </div>
            <label for="pp-banner-file" class="pj-edit-banner-empty" style="height:160px;" data-pp-banner-empty>
                <span class="plus">+</span>
                <span class="title">Adicionar banner <small>(opcional)</small></span>
                <span class="hint">JPG, PNG ou WEBP · máx. 5 MB · recomendado 1600 × 500 px</span>
            </label>
            <div class="pj-edit-banner-error" data-pp-banner-error hidden></div>

            @* ---------- Cabeçalho ---------- *@
            <div class="pj-edit-head">
                <span class="pj-chip-green">Princípio @Model.MandamentoAtual.Id</span>
                <h1>Propor novo item</h1>
                <p class="sub">"@Model.MandamentoAtual.Secular"</p>
                <div class="pj-edit-info">
                    <span class="i">i</span>
                    <div>
                        Sua proposta fica visível só pra você até um revisor ou administrador aprovar.
                        Depois de aprovada, aparece na listagem para todo mundo.
                    </div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="pj-edit-banner-error" style="margin:0 40px 16px;" role="alert"></div>

            <form method="post" data-pp-form id="pjProposeForm">
                @Html.AntiForgeryToken()

                @* ---------- Título ---------- *@
                <div class="pj-edit-body" style="padding-top:0;">
                    <div class="pj-edit-label">
                        <label for="pp-title">Título</label>
                        <small class="pj-counter" data-pp-title-counter>0 / 160</small>
                    </div>
                    <div class="pj-edit-help" style="margin-top:-4px;">A medida em uma linha, com o lema entre aspas se houver.</div>
                    <input id="pp-title" name="Input.Titulo" type="text" maxlength="160" class="pj-input-title" data-pp-title
                           value="@Model.Input.Titulo"
                           placeholder="Ex.: Fim do fundão eleitoral — &quot;Dinheiro de hospital não financia santinho&quot;" />
                </div>

                @* ---------- Texto ---------- *@
                <div class="pj-edit-body">
                    <div class="pj-edit-label">
                        <span>Texto</span>
                        <small class="pj-counter" data-pp-words>0 palavra</small>
                    </div>
                    <div class="pj-edit-help" style="margin-top:-4px;">Explique o problema, a solução e um exemplo. Use o modelo ao lado para começar.</div>

                    <div class="pj-editor">
                        <div class="pj-editor__toolbar">
                            <button type="button" data-pp-exec="formatBlock" data-pp-value="p" title="Parágrafo">Texto</button>
                            <button type="button" class="h" data-pp-exec="formatBlock" data-pp-value="h3" title="Título">Título</button>
                            <span class="sep"></span>
                            <button type="button" class="sq b" data-pp-exec="bold" title="Negrito">B</button>
                            <button type="button" class="sq i" data-pp-exec="italic" title="Itálico">I</button>
                            <button type="button" class="sq u" data-pp-exec="underline" title="Sublinhado">U</button>
                            <span class="sep"></span>
                            <button type="button" class="sq" data-pp-exec="insertOrderedList" title="Lista numerada">1.</button>
                            <button type="button" class="sq" data-pp-exec="insertUnorderedList" title="Lista">&bull;</button>
                            <button type="button" class="sq q" data-pp-exec="formatBlock" data-pp-value="blockquote" title="Citação">&rdquo;</button>
                            <button type="button" class="sq" data-pp-link title="Link">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>
                            </button>
                            <label for="pp-inline-file" class="pj-editor__img" title="Inserir imagem no texto">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="2" /><path d="m21 16-5-5-9 9" /></svg>
                                Imagem
                            </label>
                            <button type="button" class="sq muted" data-pp-exec="removeFormat" title="Limpar formatação">Tx</button>
                            <span class="grow"></span>
                            <button type="button" class="sq muted" data-pp-exec="undo" title="Desfazer">&#8630;</button>
                            <button type="button" class="sq muted" data-pp-exec="redo" title="Refazer">&#8631;</button>
                        </div>
                        <div class="pj-editor__content" contenteditable="true" data-pp-content
                             data-placeholder="Comece pelo problema: o que acontece hoje e por que precisa mudar…">@Html.Raw(Model.Input.Corpo)</div>
                    </div>
                </div>

                @* ---------- Tags ---------- *@
                <div class="pj-edit-body">
                    <div class="pj-edit-label">
                        <span>Tags <small>(até 5)</small></span>
                    </div>
                    <div class="pj-edit-help" style="margin-top:-4px;">Ajudam as pessoas a encontrar o item na busca e nas seções.</div>

                    <div class="pj-tags-edit">
                        <span data-pp-tags-list style="display:contents;"></span>

                        <span class="pj-tag-form" data-pp-tag-form hidden>
                            <input type="text" maxlength="30" placeholder="Nova tag" data-pp-tag-input />
                            <button type="button" class="add" data-pp-tag-form-add>Adicionar</button>
                            <button type="button" class="close" title="Cancelar" data-pp-tag-form-close>&times;</button>
                        </span>

                        <button type="button" class="pj-tag-add" data-pp-tag-add-btn><span>+</span>Adicionar tag</button>
                    </div>

                    <div class="pj-tag-suggest" data-pp-tag-suggest hidden>
                        @foreach (var sugestao in Model.TagsSugeridas)
                        {
                            <span data-pp-suggestion="@sugestao" hidden></span>
                        }
                    </div>

                    <input type="hidden" name="Input.Tags" data-pp-tags-hidden value="@Model.Input.Tags" />
                    <input type="hidden" name="Input.BannerUrl" data-pp-banner-url value="@Model.Input.BannerUrl" />
                    <textarea name="Input.Corpo" data-pp-hidden-content style="display:none;"></textarea>
                </div>

                @* ---------- Ações ---------- *@
                <div class="pj-edit-foot" style="padding-top:28px;">
                    <div class="pj-edit-actions" style="margin-top:0;">
                        <span class="pj-edit-actions__note" data-pp-missing>Falta: título e texto com pelo menos 30 palavras.</span>
                        <div class="pj-edit-actions__buttons">
                            <a href="/" class="pj-edit-cancel">Cancelar</a>
                            <button type="submit" class="pj-btn pj-btn--navy" data-pp-submit disabled>Enviar para revisão</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* ---------- Lateral ---------- *@
    <aside class="pj-edit-side">
        <div class="pj-card pj-proposal">
            <div class="pj-side-head" style="padding:0; border:none; margin-bottom:12px;">Antes de enviar</div>
            <div class="pj-checklist">
                <div data-pp-check="title"><span class="box"></span>Título claro, com a medida em uma linha</div>
                <div data-pp-check="text"><span class="box"></span>Texto explicando problema e solução (30+ palavras)</div>
                <div data-pp-check="tags"><span class="box"></span>Pelo menos uma tag</div>
                <div data-pp-check="banner"><span class="box"></span>Banner (opcional)</div>
            </div>
        </div>

        <div class="pj-card" style="overflow:hidden;">
            <div class="pj-side-head">
                Modelo de texto
                <div class="pj-side-sub">Insere a seção no fim do texto.</div>
            </div>
            <div class="pj-toc">
                <button type="button" class="pj-template" data-pp-template="&lt;h3&gt;O problema&lt;/h3&gt;&lt;p&gt;Descreva a situação atual e por que ela precisa mudar.&lt;/p&gt;">
                    <span class="plus">+</span>
                    <span><b>O problema</b><small>O que acontece hoje e quem é afetado.</small></span>
                </button>
                <button type="button" class="pj-template" data-pp-template="&lt;h3&gt;A solução&lt;/h3&gt;&lt;p&gt;Explique a mudança proposta de forma direta.&lt;/p&gt;">
                    <span class="plus">+</span>
                    <span><b>A solução</b><small>O que a lei deve passar a dizer.</small></span>
                </button>
                <button type="button" class="pj-template" data-pp-template="&lt;h3&gt;Como funcionaria&lt;/h3&gt;&lt;ol&gt;&lt;li&gt;Primeira regra&lt;/li&gt;&lt;li&gt;Segunda regra&lt;/li&gt;&lt;/ol&gt;">
                    <span class="plus">+</span>
                    <span><b>Como funcionaria</b><small>Passos ou regras em lista.</small></span>
                </button>
                <button type="button" class="pj-template" data-pp-template="&lt;h3&gt;Exemplo real&lt;/h3&gt;&lt;p&gt;Cite onde algo parecido já existe e o resultado.&lt;/p&gt;">
                    <span class="plus">+</span>
                    <span><b>Exemplo real</b><small>País ou caso onde já funciona.</small></span>
                </button>
            </div>
        </div>

        <div class="pj-steps">
            <h3>Como é revisado</h3>
            <div><span>1</span>Você envia; o item fica visível só pra você.</div>
            <div><span>2</span>Um revisor ou administrador lê e aprova ou devolve com o motivo.</div>
            <div><span>3</span>Aprovado, aparece na listagem do princípio para todo mundo.</div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/projeta-propose.js" asp-append-version="true"></script>
}
