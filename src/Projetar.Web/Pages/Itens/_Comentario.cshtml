@model Projetar.Web.Models.Comentario
@{
    var slug = (string)ViewData["Slug"]!;
    var usuarioAtualId = ViewData["UsuarioAtualId"] as string;
    var ehModerador = ViewData["EhModerador"] is true;
    var podeParticipar = ViewData["PodeParticipar"] is true;
    var podeRemover = !Model.Removido && (Model.UsuarioId == usuarioAtualId || ehModerador);
}
<div class="pj-comment @(Model.Removido ? "pj-comment--removido" : null)">
    <div class="pj-comment__head">
        <span class="pj-comment__author">@(Model.Removido ? "—" : (Model.Usuario?.NomeCompleto ?? "Usuário removido"))</span>
        <span class="pj-comment__date">@Model.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
    </div>
    <p class="pj-comment__text">@(Model.Removido ? "[comentário removido]" : Model.Texto)</p>

    <div class="pj-comment__actions">
        @if (!Model.Removido && podeParticipar)
        {
            <details>
                <summary style="cursor:pointer; list-style:none; color:var(--pj-green-dark); font-size:12.5px;">Responder</summary>
                <form method="post" asp-page="/Itens/Index" asp-page-handler="Comentario" asp-route-slug="@slug" class="pj-comment__reply-form">
                    <textarea rows="2" name="NovoComentario.Texto" required></textarea>
                    <input type="hidden" name="NovoComentario.ComentarioPaiId" value="@Model.Id" />
                    <div style="margin-top:8px;">
                        <button type="submit" class="pj-btn pj-btn--outline-navy pj-btn--sm">Enviar resposta</button>
                    </div>
                </form>
            </details>
        }
        @if (podeRemover)
        {
            <form method="post" asp-page="/Itens/Index" asp-page-handler="RemoverComentario" asp-route-slug="@slug" asp-route-id="@Model.Id">
                <button type="submit" class="muted">Remover</button>
            </form>
        }
    </div>

    @if (Model.Respostas.Count > 0)
    {
        <div class="pj-comment__replies">
            @foreach (var resposta in Model.Respostas.OrderBy(r => r.DataCriacao))
            {
                <partial name="_Comentario" model="resposta" />
            }
        </div>
    }
</div>
