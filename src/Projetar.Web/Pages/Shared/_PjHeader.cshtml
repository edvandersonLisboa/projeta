@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Projetar.Web.Data
@using Projetar.Web.Models
@using Projetar.Web.Services
@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@{
    // Cabeçalho único do site — mesma estrutura em toda página, igual à Home.
    // Não varia por página: sempre o header claro (variant "light" do design original).
    var navAtivo = ViewData["NavAtivo"] as string ?? "Início";
    var hoje = DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", CultureInfo.GetCultureInfo("pt-BR"));

    var navItems = new (string Label, string Href)[]
    {
        ("Início", "/"),
        ("Ideias", "/Ideias"),
        ("Sobre", "/Sobre"),
    };

    List<Notificacao> notifRecentes = [];
    var totalNaoLidas = 0;
    ApplicationUser? usuarioAtual = null;
    if (SignInManager.IsSignedIn(User))
    {
        usuarioAtual = await UserManager.GetUserAsync(User);
        var usuarioLogadoId = usuarioAtual?.Id;
        totalNaoLidas = await Db.Notificacoes.CountAsync(n => n.UsuarioDestinoId == usuarioLogadoId && !n.Lida);
        notifRecentes = await Db.Notificacoes
            .Where(n => n.UsuarioDestinoId == usuarioLogadoId && !n.Lida)
            .OrderByDescending(n => n.DataCriacao)
            .Take(5)
            .AsNoTracking()
            .ToListAsync();
    }
}
<div class="pj-utility">
    @hoje &nbsp;&middot;&nbsp; Agenda Cívico Brasileiro
    @if (ViewData["TopbarContexto"] is string topbarContexto)
    {
        <text>&nbsp;&middot;&nbsp; @topbarContexto</text>
    }
</div>

<header class="pj-header">
    <div class="pj-shell pj-header__inner">
        <a href="/" class="pj-logo">
            <img src="/img/simbolo.svg" alt="Projeta" />
            <span class="pj-logo__word">PROJETA</span>
        </a>
        <form class="pj-search" method="get" action="/Busca" role="search">
            <input type="search" name="q" placeholder="Pesquisar princípios, ideias e propostas de lei..." value="@(ViewData["BuscaQuery"] as string)" />
            <button type="submit" class="pj-btn pj-btn--green pj-btn--search">Pesquisar</button>
        </form>
    </div>
</header>

<nav class="pj-nav">
    <div class="pj-shell pj-nav__inner">
        <div class="pj-nav__links">
            @foreach (var item in navItems)
            {
                <a href="@item.Href" class="@(item.Label == navAtivo ? "active" : null)">@item.Label</a>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Revisor"))
            {
                <a href="/Moderacao/Index" class="@(navAtivo == "Moderação" ? "active" : null)">Moderação</a>
            }
        </div>
        
        <div class="pj-nav__actions">
            @if (User.IsInRole("Admin"))
            {
                <a href="/Principios/Gerenciar">Seções</a>
                <a href="/Admin/Permissoes">Permissões</a>
            }
              <a href="/#principios" data-propor-toggle class="pj-pill pj-pill--gold">Propor ideia</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="pj-notif" data-notif>
                    <button type="button" class="pj-notif__sino" data-notif-toggle aria-haspopup="true" aria-expanded="false" title="Notificações">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                        </svg>
                        <span class="pj-notif__badge" data-notif-badge@(totalNaoLidas > 0 ? "" : " hidden")>@(totalNaoLidas > 99 ? "99+" : totalNaoLidas.ToString())</span>
                    </button>
                    <div class="pj-notif__dropdown" data-notif-dropdown>
                        <div class="pj-notif__dropdown-head">
                            <span>Notificações</span>
                            <span class="count" data-notif-count-label>@totalNaoLidas não lida@(totalNaoLidas == 1 ? "" : "s")</span>
                        </div>
                        <div class="pj-notif__lista" data-notif-lista>
                            @if (notifRecentes.Count == 0)
                            {
                                <div class="pj-notif__vazio">Nenhuma notificação nova.</div>
                            }
                            else
                            {
                                @foreach (var n in notifRecentes)
                                {
                                    <a class="pj-notif__item" href="/Notificacoes?handler=Abrir&amp;id=@n.Id">
                                        <span class="pj-notif__icone @n.Tipo.ClasseIcone()"></span>
                                        <span class="pj-notif__item-body">
                                            <span class="pj-notif__item-titulo">@n.Titulo</span>
                                            <span class="pj-notif__item-msg">@n.Mensagem</span>
                                            <span class="pj-notif__item-tempo">@TempoRelativo.Formatar(n.DataCriacao)</span>
                                        </span>
                                    </a>
                                }
                            }
                        </div>
                        <a href="/Notificacoes" class="pj-notif__vermais">Ver mais</a>
                    </div>
                </div>

                <div class="pj-user-menu" data-user-menu>
                    <button type="button" class="pj-user-menu__trigger" data-user-menu-toggle aria-haspopup="true" aria-expanded="false" title="Minha conta">
                        <span class="pj-avatar" style="background:@AvatarUtils.Color(usuarioAtual?.NomeCompleto ?? "Você")">@AvatarUtils.Initials(usuarioAtual?.NomeCompleto ?? "Você")</span>
                    </button>
                    <div class="pj-user-menu__dropdown" data-user-menu-dropdown>
                        <div class="pj-user-menu__head">
                            <span class="pj-avatar pj-avatar--lg" style="background:@AvatarUtils.Color(usuarioAtual?.NomeCompleto ?? "Você")">@AvatarUtils.Initials(usuarioAtual?.NomeCompleto ?? "Você")</span>
                            <span class="pj-user-menu__info">
                                <span class="pj-user-menu__nome">@(usuarioAtual?.NomeCompleto ?? "Você")</span>
                                <span class="pj-user-menu__email">@usuarioAtual?.Email</span>
                            </span>
                        </div>
                        @if (usuarioAtual is not null && !usuarioAtual.PerfilCompleto)
                        {
                            <a href="/Conta/CompletarPerfil" class="pj-user-menu__item">Completar perfil</a>
                        }
                        <a href="/Conta/EditarPerfil" class="pj-user-menu__item">Editar perfil</a>
                        <a href="/Historico/Index" class="pj-user-menu__item">Meu Histórico</a>
                        <form method="post" asp-area="" asp-page="/Conta/Sair">
                            <button type="submit" class="pj-user-menu__item pj-user-menu__item--danger">Sair</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a href="/Conta/Entrar" class="muted">Entrar</a>
            }
          
        </div>
    </div>
</nav>

@* ---------- Barra mobile (< 760px): ☰ + página atual + Propor ideia ---------- *@
<div class="pj-mnav" data-mnav>
    <div class="pj-mnav__bar">
        <button type="button" class="pj-mnav__burger" data-mnav-toggle aria-label="Abrir menu" aria-expanded="false">
            <svg class="icon-abrir" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="icon-fechar" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <span class="pj-mnav__current">@navAtivo</span>
        <a href="/#principios" data-propor-toggle class="pj-pill pj-pill--gold">Propor ideia</a>
    </div>
    <nav class="pj-mnav__panel" data-mnav-panel aria-label="Menu principal">
        @foreach (var item in navItems)
        {
            <a href="@item.Href" class="@(item.Label == navAtivo ? "active" : null)">@item.Label</a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Revisor"))
        {
            <a href="/Moderacao/Index" class="@(navAtivo == "Moderação" ? "active" : null)">Moderação</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a href="/Principios/Gerenciar">Seções</a>
            <a href="/Admin/Permissoes">Permissões</a>
        }
        @if (SignInManager.IsSignedIn(User))
        {
            <a href="/Notificacoes">
                Notificações
                @if (totalNaoLidas > 0)
                {
                    <span class="badge">@(totalNaoLidas > 99 ? "99+" : totalNaoLidas.ToString())</span>
                }
            </a>
            @if (usuarioAtual is not null && !usuarioAtual.PerfilCompleto)
            {
                <a href="/Conta/CompletarPerfil">Completar perfil</a>
            }
            <a href="/Conta/EditarPerfil">Editar perfil</a>
            <a href="/Historico/Index">Meu Histórico</a>
            <form method="post" asp-area="" asp-page="/Conta/Sair">
                <button type="submit" class="pj-link-like">Sair</button>
            </form>
        }
        else
        {
            <a href="/Conta/Entrar">Entrar</a>
        }
    </nav>
</div>

<div class="pj-rule"><span></span><span></span><span></span></div>
