@using Projetar.Web.Models
<!DOCTYPE html>
<html lang="pt-br" data-theme="claro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projeta</title>
    <partial name="_SeoMeta" />
    <link rel="icon" type="image/svg+xml" href="~/img/simbolo.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="~/css/govbr.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/principios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projeta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/projeta-extra.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projetar.Web.styles.css" asp-append-version="true" />
    <script src="~/js/govbr-theme.js"></script>
</head>
@{
    // Cabeçalho e rodapé são os mesmos em toda página (partials _PjHeader/_PjFooter,
    // igual à Home) — só o conteúdo de cada página continua no tema gbr por enquanto.
    if (ViewData["NavAtivo"] is null)
    {
        var caminhoAtual = ViewContext.HttpContext.Request.Path.Value ?? "/";
        ViewData["NavAtivo"] = caminhoAtual.StartsWith("/Sobre", StringComparison.OrdinalIgnoreCase) ? "Sobre"
            : caminhoAtual.StartsWith("/Moderacao", StringComparison.OrdinalIgnoreCase) ? "Moderação"
            : caminhoAtual.StartsWith("/Ideias", StringComparison.OrdinalIgnoreCase) ? "Ideias"
            : "Início";
    }

    var _pjMsgSucesso = TempData["MensagemSucesso"] as string;
    var _pjMsgErro = TempData["MensagemErro"] as string;
}
<body class="gbr">
<div class="pj-app">
    <partial name="_PjHeader" />

    @if (ViewData["Breadcrumbs"] is List<(string Texto, string? Url)> migalhas)
    {
        <partial name="_Breadcrumb" model="migalhas" />
    }

    <main class="gbr-main gbr-container">
        @RenderBody()
    </main>

    <partial name="_PjFooter" />
</div>
<partial name="_PjModalPropor" />

    <script src="~/js/pj-snackbar.js" asp-append-version="true"></script>
    <script src="~/js/navbar-menu.js" asp-append-version="true"></script>
    <script src="~/js/notificacoes-sino.js" asp-append-version="true"></script>
    <script src="~/js/pj-user-menu.js" asp-append-version="true"></script>
    <script src="~/js/pj-mobile-nav.js" asp-append-version="true"></script>
    <script src="~/js/pj-modal-propor.js" asp-append-version="true"></script>

    @if (_pjMsgSucesso is not null)
    {
        <script>window.pjSnackbar(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_pjMsgSucesso)), 'success');</script>
    }
    @if (_pjMsgErro is not null)
    {
        <script>window.pjSnackbar(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_pjMsgErro)), 'error');</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
