@page
@model IndexModel
@{
    Layout = "_LayoutPj";
    ViewData["Title"] = "Decálogo Cívico Brasileiro";
    ViewData["NavAtivo"] = "Início";
}

@* ---------- Hero ---------- *@
<section class="pj-hero">
    <div class="pj-shell pj-hero__inner">
        <div>
            <div class="pj-eyebrow pj-eyebrow--badge"><i></i>Por leis melhores</div>
            <h1>Decálogo Cívico Brasileiro</h1>
            <p>
                Uma agenda cívica escrita pela comunidade — cada princípio nasce, é discutido,
                votado com justificativa e revisado por quem quer ver o Brasil governado de outro jeito.
            </p>
            <div class="pj-hero__actions">
                <a href="#principios" class="pj-btn pj-btn--navy">Ler as Propostas</a>
                <a href="#principios" class="pj-btn pj-btn--outline-green">Propor uma ideia</a>
            </div>
            <div class="pj-hero__meta">
                <span class="chip">Agenda cívica e laica</span>
                @if (Model.EhAdmin)
                {
                    <a href="/Principios/Gerenciar">Gerenciar visibilidade das seções</a>
                }
            </div>
        </div>

        <aside class="pj-hero__card">
            <img src="~/img/projeta-horizontal-claro.svg" asp-append-version="true" alt="Projeta — Sua voz ajuda a mudar o Brasil" />
            <div class="pj-stats">
                <div>
                    <div class="pj-stats__n pj-stats__n--navy">@Model.PrincipiosList.Count</div>
                    <div class="pj-stats__label">Princípios</div>
                </div>
                <div>
                    <div class="pj-stats__n pj-stats__n--green">@Model.TotalMedidas</div>
                    <div class="pj-stats__label">Medidas</div>
                </div>
                <div>
                    <div class="pj-stats__n pj-stats__n--gold">@Model.TotalAvaliadas</div>
                    <div class="pj-stats__label">Avaliadas</div>
                </div>
            </div>
        </aside>
    </div>
</section>

@* ---------- Princípios ---------- *@
<section class="pj-shell pj-section" id="principios">
    <div class="pj-section__head">
        <div>
            <span class="pj-eyebrow">Os dez princípios</span>
            <h2 class="pj-h2">Abra um princípio para ver as medidas</h2>
        </div>
        <div class="pj-section__tools">
            <button type="button" class="pj-btn pj-btn--sm" id="pjExpandAll">Abrir todos</button>
            <button type="button" class="pj-btn pj-btn--sm" id="pjCollapseAll">Fechar todos</button>
        </div>
    </div>

    <div class="pj-accordion">
        @foreach (var m in Model.PrincipiosList)
        {
            var isOpen = m.Id == 1;

            <article class="pj-principle @(isOpen ? "is-open" : null)" id="principio-@m.Id">
                <button type="button" class="pj-principle__head" aria-expanded="@(isOpen ? "true" : "false")">
                    <span class="pj-principle__badge">@m.Id</span>
                    <span style="flex:1; min-width:0;">
                        <span class="pj-principle__label">Princípio @m.Id</span>
                        <span class="pj-principle__title">@m.Secular</span>
                        @if (!string.IsNullOrWhiteSpace(m.Subtitulo))
                        {
                            <span class="pj-principle__subtitle">@m.Subtitulo</span>
                        }
                    </span>
                    <span class="pj-principle__aside">
                        @if (!m.Visivel)
                        {
                            <span class="pj-flag">Oculto</span>
                        }
                        <span class="pj-principle__count">@Model.CountLabel(m)</span>
                        <span class="pj-principle__chevron">&#9662;</span>
                    </span>
                </button>

                <div class="pj-principle__body">
                    <p>@m.Intro</p>

                    @if (m.Itens.Count > 0)
                    {
                        <div class="pj-measures">
                            @foreach (var item in m.Itens)
                            {
                                var avaliacao = Model.AvaliacoesPorItem.GetValueOrDefault(item.Id);
                                <div class="pj-measure">
                                    <span class="pj-measure__marker">&#9656;</span>
                                    <div class="pj-measure__text"><a href="/Itens/@item.Slug">@item.Titulo</a></div>
                                    <div class="pj-measure__aside">
                                        @if (!item.Visivel)
                                        {
                                            <span class="pj-flag">Oculto</span>
                                        }
                                        @if (avaliacao is not null)
                                        {
                                            <span class="pj-stars">@Html.Raw(new string('★', (int)Math.Round(avaliacao.Media)) + new string('☆', 5 - (int)Math.Round(avaliacao.Media)))</span>
                                        }
                                        <span class="pj-rating-note">@(avaliacao?.Total ?? 0) avaliaç@((avaliacao?.Total ?? 0) == 1 ? "ão" : "ões")</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <a href="/Principios/@m.Id/Propor" class="pj-add-item">
                            + Propor novo item para este princípio
                        </a>
                    }
                    else
                    {
                        <div class="pj-empty">
                            <p>Nenhuma medida proposta para este princípio ainda.</p>
                            <a href="/Principios/@m.Id/Propor" class="pj-btn pj-btn--green pj-btn--sm">
                                Propor a primeira medida
                            </a>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</section>

@* ---------- CTA ---------- *@
<section class="pj-shell" style="padding:44px 28px 0;">
    <div class="pj-cta">
        <div>
            <h2>Sua voz ajuda a mudar o Brasil</h2>
            <p>
                Propor uma ideia, sugerir uma redação melhor ou enviar uma referência —
                toda contribuição passa por revisão da comunidade antes de entrar nas Propostas.
            </p>
        </div>
        <div class="pj-cta__actions">
            <a href="#principios" class="pj-btn pj-btn--gold">Propor ideia</a>
            <a href="/Sobre#como-funciona" class="pj-btn pj-btn--outline-light">Ser revisor</a>
        </div>
    </div>
    <p class="pj-signature">Projeto Brasil — Política como arte de governar o bem comum, não o bem próprio.</p>
</section>

@section Scripts {
    <script src="~/js/projeta-accordion.js" asp-append-version="true"></script>
}
