@page
@model Projetar.Web.Pages.Conta.EsqueciSenhaModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}

<div class="gbr-card gbr-auth-card">
    <h1 class="gbr-h3 gbr-auth-card__title">Esqueceu sua senha?</h1>
    <p class="gbr-muted gbr-auth-card__subtitle">Informe seu e-mail e enviaremos um código para redefinir sua senha.</p>

    <div asp-validation-summary="ModelOnly" class="gbr-alert gbr-alert--danger" role="alert"></div>

    <form method="post" class="gbr-stack">
        <div class="gbr-field">
            <label class="gbr-label" asp-for="Input.Email"></label>
            <input class="gbr-input" asp-for="Input.Email" autocomplete="email" />
            <span class="gbr-help gbr-help--error" asp-validation-for="Input.Email"></span>
        </div>

        <button type="submit" class="gbr-btn gbr-btn--primary gbr-btn--block gbr-btn--lg">Enviar código</button>
    </form>

    <p class="gbr-muted gbr-auth-card__footer">
        Lembrou a senha? <a asp-page="./Entrar">Entrar</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
