@page
@model Mandamentos.Web.Pages.Conta.ConfirmarCodigoModel
@{
    ViewData["Title"] = "Confirmar e-mail";
}

<div class="gbr-card gbr-auth-card">
    <h1 class="gbr-h3 gbr-auth-card__title">Confirme seu e-mail</h1>
    <p class="gbr-muted gbr-auth-card__subtitle">
        Enviamos um código de 6 dígitos para <strong>@Model.Email</strong>. Ele expira em 15 minutos.
    </p>

    @if (Model.Mensagem is not null)
    {
        <div class="gbr-alert gbr-alert--success" role="status">
            <div class="gbr-alert__body">@Model.Mensagem</div>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="gbr-alert gbr-alert--danger" role="alert"></div>

    <form method="post" class="gbr-stack">
        <input type="hidden" asp-for="Email" />
        <div class="gbr-field">
            <label class="gbr-label" asp-for="Input.Codigo"></label>
            <input class="gbr-input" asp-for="Input.Codigo" inputmode="numeric" autocomplete="one-time-code" maxlength="6" style="letter-spacing:6px;text-align:center;font-size:1.3em;" />
            <span class="gbr-help gbr-help--error" asp-validation-for="Input.Codigo"></span>
        </div>

        <button type="submit" class="gbr-btn gbr-btn--primary gbr-btn--block gbr-btn--lg">Confirmar</button>
    </form>

    <form method="post" asp-page-handler="Reenviar" style="margin-top:var(--gbr-space-3);">
        <input type="hidden" asp-for="Email" />
        <button type="submit" class="gbr-btn gbr-btn--ghost gbr-btn--block">Reenviar código</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
