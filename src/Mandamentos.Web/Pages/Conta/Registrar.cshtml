@page
@model Mandamentos.Web.Pages.Conta.RegistrarModel
@{
    ViewData["Title"] = "Criar conta";
}

<div class="gbr-card gbr-auth-card">
    <h1 class="gbr-h3 gbr-auth-card__title">Criar conta</h1>
    <p class="gbr-muted gbr-auth-card__subtitle">Participe propondo, avaliando e comentando as leis do decálogo.</p>

    <div asp-validation-summary="ModelOnly" class="gbr-alert gbr-alert--danger" role="alert"></div>

    <form method="post" class="gbr-stack">
        <div class="gbr-row gbr-auth-card__row">
            <div class="gbr-field" style="flex:1;">
                <label class="gbr-label" asp-for="Input.Nome"></label>
                <input class="gbr-input" asp-for="Input.Nome" autocomplete="given-name" />
                <span class="gbr-help gbr-help--error" asp-validation-for="Input.Nome"></span>
            </div>
            <div class="gbr-field" style="flex:1;">
                <label class="gbr-label" asp-for="Input.Sobrenome"></label>
                <input class="gbr-input" asp-for="Input.Sobrenome" autocomplete="family-name" />
                <span class="gbr-help gbr-help--error" asp-validation-for="Input.Sobrenome"></span>
            </div>
        </div>

        <div class="gbr-field">
            <label class="gbr-label" asp-for="Input.Email"></label>
            <input class="gbr-input" asp-for="Input.Email" autocomplete="email" />
            <span class="gbr-help gbr-help--error" asp-validation-for="Input.Email"></span>
        </div>

        <div class="gbr-field">
            <label class="gbr-label" asp-for="Input.Senha"></label>
            <input class="gbr-input" asp-for="Input.Senha" autocomplete="new-password" />
            <span class="gbr-help gbr-help--error" asp-validation-for="Input.Senha"></span>
        </div>

        <div class="gbr-field">
            <label class="gbr-label" asp-for="Input.ConfirmarSenha"></label>
            <input class="gbr-input" asp-for="Input.ConfirmarSenha" autocomplete="new-password" />
            <span class="gbr-help gbr-help--error" asp-validation-for="Input.ConfirmarSenha"></span>
        </div>

        <button type="submit" class="gbr-btn gbr-btn--primary gbr-btn--block gbr-btn--lg">Criar conta</button>
    </form>

    <hr class="gbr-divider" />

    <form method="post" asp-page="./Entrar" asp-page-handler="Google">
        <button type="submit" class="gbr-btn gbr-btn--outline gbr-btn--block">Continuar com Google</button>
    </form>

    <p class="gbr-muted gbr-auth-card__footer">
        Já tem conta? <a asp-page="./Entrar">Entrar</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
